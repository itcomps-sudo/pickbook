# Neon Postgres connection string (make a new database just for Pickbook)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/pickbook?sslmode=require"

# Free key from https://the-odds-api.com
ODDS_API_KEY=""

# Passcode you type to unlock the app, plus a long random string
APP_PASSCODE=""
AUTH_SECRET=""

# Vercel sends this with the daily cron call; any long random string
CRON_SECRET=""

# Optional: sportsbook to track (draftkings, fanduel, betmgm, caesars...)
ODDS_BOOK="draftkings"
# Optional: minutes before lines are pulled again when you open the app
ODDS_REFRESH_MINUTES="180"
